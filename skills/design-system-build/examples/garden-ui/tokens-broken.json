{
  "about": "Deliberately broken copy of tokens.json, to show each check failing.",
  "color": {
    "ink": "#1d1d1b",
    "ink-muted": "#a9a69f",
    "surface": "#ffffff",
    "canvas": "#f4f1ea",
    "accent": "#7cc48f",
    "accent-hover": "#185a2f",
    "on-accent": "#ffffff",
    "border": "#e2dfd8",
    "focus": "#1d1d1b",
    "danger": "#b3261e",
    "disabled-bg": "#e6e3dc",
    "disabled-ink": "#6b6862"
  },
  "space": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "16px",
    "xl": "40px"
  },
  "radius": {
    "control": "6px",
    "card": "12px"
  },
  "font": {
    "family": {
      "body": "system-ui, \"Segoe UI\", Roboto, sans-serif"
    },
    "size": {
      "sm": "14px",
      "md": "16px",
      "lg": "20px",
      "xl": "28px"
    },
    "weight": {
      "regular": "400",
      "strong": "650"
    },
    "line": {
      "body": "1.5",
      "tight": "1.2"
    }
  },
  "motion": {
    "duration": {
      "quick": "120ms",
      "settle": "0.22s"
    },
    "easing": {
      "standard": "cubic-bezier(.2, 0, 0, 1)"
    }
  },
  "control": {
    "min-height": "44px",
    "padding-x": "{space.xxl}"
  },
  "pairs": [
    {
      "fg": "color.ink",
      "bg": "color.surface",
      "use": "text",
      "why": "body copy"
    },
    {
      "fg": "color.ink-muted",
      "bg": "color.surface",
      "use": "text",
      "why": "help text"
    },
    {
      "fg": "color.ink",
      "bg": "color.canvas",
      "use": "text",
      "why": "page text"
    },
    {
      "fg": "color.on-accent",
      "bg": "color.accent",
      "use": "text",
      "why": "primary button"
    },
    {
      "fg": "color.on-accent",
      "bg": "color.accent-hover",
      "use": "text",
      "why": "primary button, hover"
    },
    {
      "fg": "color.danger",
      "bg": "color.surface",
      "use": "text",
      "why": "error message"
    },
    {
      "fg": "color.border",
      "bg": "color.surface",
      "use": "ui",
      "why": "input border"
    },
    {
      "fg": "color.focus",
      "bg": "color.surface",
      "use": "ui",
      "why": "focus ring"
    },
    {
      "fg": "color.disabled-ink",
      "bg": "color.disabled-bg",
      "use": "text",
      "why": "disabled label (not required by WCAG, kept readable on purpose)"
    }
  ],
  "components": {
    "button": {
      "states": [
        "default",
        "hover",
        "focus-visible",
        "active",
        "disabled"
      ],
      "tokens": [
        "color.accent",
        "color.accent-hover",
        "color.on-accent",
        "color.focus",
        "color.disabled-bg",
        "color.disabled-ink",
        "radius.control",
        "control.min-height"
      ]
    },
    "input": {
      "states": [
        "default",
        "hover",
        "focus-visible",
        "invalid",
        "disabled"
      ],
      "tokens": [
        "color.border",
        "color.focus",
        "color.danger",
        "radius.control",
        "control.min-height"
      ]
    },
    "card": {
      "states": [
        "default",
        "hover"
      ],
      "tokens": [
        "color.surface",
        "radius.card",
        "space.lg"
      ]
    }
  }
}