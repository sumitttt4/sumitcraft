{
  "about": "Original example tokens for a made-up community-garden app (Larkfield). Provisional choices, not a house style.",
  "color": {
    "ink": "#1d1d1b",
    "ink-muted": "#55534d",
    "surface": "#ffffff",
    "canvas": "#f4f1ea",
    "accent": "#1f6f3a",
    "accent-hover": "#185a2f",
    "on-accent": "{color.surface}",
    "border": "#8a8780",
    "focus": "{color.ink}",
    "danger": "#b3261e",
    "disabled-bg": "#e6e3dc",
    "disabled-ink": "#5f5c56"
  },
  "space": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "40px"
  },
  "radius": {
    "control": "6px",
    "card": "12px"
  },
  "font": {
    "family": {
      "body": "system-ui, \"Segoe UI\", Roboto, sans-serif"
    },
    "size": {
      "sm": "14px",
      "md": "16px",
      "lg": "20px",
      "xl": "28px"
    },
    "weight": {
      "regular": "400",
      "strong": "650"
    },
    "line": {
      "body": "1.5",
      "tight": "1.2"
    }
  },
  "motion": {
    "duration": {
      "quick": "120ms",
      "settle": "220ms"
    },
    "easing": {
      "standard": "cubic-bezier(.2, 0, 0, 1)"
    }
  },
  "control": {
    "min-height": "44px",
    "padding-x": "{space.md}"
  },
  "pairs": [
    {
      "fg": "color.ink",
      "bg": "color.surface",
      "use": "text",
      "why": "body copy"
    },
    {
      "fg": "color.ink-muted",
      "bg": "color.surface",
      "use": "text",
      "why": "help text"
    },
    {
      "fg": "color.ink",
      "bg": "color.canvas",
      "use": "text",
      "why": "page text"
    },
    {
      "fg": "color.on-accent",
      "bg": "color.accent",
      "use": "text",
      "why": "primary button"
    },
    {
      "fg": "color.on-accent",
      "bg": "color.accent-hover",
      "use": "text",
      "why": "primary button, hover"
    },
    {
      "fg": "color.danger",
      "bg": "color.surface",
      "use": "text",
      "why": "error message"
    },
    {
      "fg": "color.border",
      "bg": "color.surface",
      "use": "ui",
      "why": "input border"
    },
    {
      "fg": "color.focus",
      "bg": "color.surface",
      "use": "ui",
      "why": "focus ring"
    },
    {
      "fg": "color.disabled-ink",
      "bg": "color.disabled-bg",
      "use": "text",
      "why": "disabled label (not required by WCAG, kept readable on purpose)"
    }
  ],
  "components": {
    "button": {
      "states": [
        "default",
        "hover",
        "focus-visible",
        "active",
        "disabled"
      ],
      "tokens": [
        "color.accent",
        "color.accent-hover",
        "color.on-accent",
        "color.focus",
        "color.disabled-bg",
        "color.disabled-ink",
        "radius.control",
        "control.min-height"
      ]
    },
    "input": {
      "states": [
        "default",
        "hover",
        "focus-visible",
        "invalid",
        "disabled"
      ],
      "tokens": [
        "color.border",
        "color.focus",
        "color.danger",
        "radius.control",
        "control.min-height"
      ]
    },
    "card": {
      "states": [
        "default",
        "hover",
        "focus-visible",
        "disabled"
      ],
      "tokens": [
        "color.surface",
        "radius.card",
        "space.lg"
      ]
    }
  },
  "layout": {
    "max-width": "960px",
    "card-min": "260px"
  },
  "border": {
    "width": "1px"
  }
}